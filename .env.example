# Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one guild for instant updates while developing
DISCORD_GUILD_ID=

# Permanent Hypixel API key (sent as the API-Key header, never logged)
HYPIXEL_API_KEY=

# Pause keyed requests when the remaining count drops to this or lower
HYPIXEL_RATE_LOW_WATER=5
